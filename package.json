{
  "name": "nidelle",
  "version": "2.3.0",
  "private": true,
  "description": "Nidelle : alimentation pendant la grossesse, recettes et carnet synchronisé.",
  "scripts": {
    "start": "node --env-file-if-exists=.env.development.local scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.cjs",
    "dev": "npm run build && npm start",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/migrate.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@zxing/browser": "0.2.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0"
  }
}
