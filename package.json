{
  "name": "poum",
  "version": "4.0.13",
  "private": true,
  "description": "Poum : calendrier de grossesse, suivi documentaire des examens et repas adaptés.",
  "scripts": {
    "start": "node --env-file-if-exists=.env.development.local scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.cjs",
    "dev": "npm run build && npm start",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/migrate.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@zxing/browser": "0.2.1",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "stripe": "22.6.2"
  },
  "engines": {
    "node": "24.x"
  }
}
