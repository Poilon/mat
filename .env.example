# Server-only values supplied by the dedicated Neon integration in Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
# Optional public build URL. No credential belongs in PUBLIC_* or js/runtime.js.
PUBLIC_APP_URL=https://mat-sandy-six.vercel.app/

# Stripe server values: keep all five values in the SAME Stripe mode.
# Production: sk_live_... / Development: sk_test_...; never a CLI OAuth token.
# Empty configuration leaves checkout closed and the workshop offered.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PASS=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_WEBHOOK_SECRET=
